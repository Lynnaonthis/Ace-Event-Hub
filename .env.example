# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file to GitHub.

# Africa's Talking credentials (get these from account.africastalking.com)
AT_USERNAME=sandbox
AT_API_KEY=your_sandbox_api_key_here

# Event details (used in SMS messages and the dashboard)
EVENT_NAME=Our Hackathon Event
EVENT_DATE=2026-10-15
EVENT_VENUE=iHub, Nairobi

# Port the server runs on (bolt.new usually sets this automatically)
PORT=5000
